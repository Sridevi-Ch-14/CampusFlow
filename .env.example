MYSQL_PASSWORD=password
MYSQL_DATABASE=campusflow_db

# Storage
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=uploads

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
