# Project
PROJECT_NAME=CampusFlow
ENVIRONMENT=development
DEBUG=True

# Security / Auth
SECRET_KEY=campusflow-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
